      "scenario_id": "SC-KIT-001",
      "schema_version": 1,
      "scenario_name": "Cooking left unattended",
      "category": "kitchen",
      "status": "draft",
      "detectability": "direct",
      "claim_class": "observation",
      "risk_level": "CRITICAL",
      "priority": 5,
      "condition": "(in_room(room='kitchen') AND present_for(class_name='stove', seconds=60) AND ever_seen(class_name='person') AND absent_for(class_name='person', seconds=900))",
      "required_objects": [
        "person",
        "stove"
      ],
      "optional_objects": [
        "knife",
        "gas_cylinder"
      ],
      "suppress_during": [],
      "room_context": "kitchen",
      "min_confidence": 0.35,
      "min_dwell_seconds": 120.0,
      "clear_after_seconds": 120.0,
      "cooldown_seconds": 1800,
      "max_repeats": 1,
      "max_per_day": 4,
      "quiet_hours": {
        "start": "21:00",
        "end": "06:00",
        "behaviour": "always_speak"
      },
      "patient_facing": true,
      "messages": {
        "en": "Nobody has been near the stove for a while.",
        "hi": "काफ़ी देर से चूल्हे के पास कोई नहीं है।"
      },
      "next_best_action": "Ask someone to check the kitchen",
      "caregiver_channel": "push",
      "escalation": [
        {
          "after_seconds": 300.0,
          "action": "notify_caregiver",
          "messages": {}
        }
      ],
      "evidence": [
        {
          "source_id": "NFPA-CookingSafety",
          "section": "Unattended cooking",
          "item": "Unattended cooking is the leading contributing factor in home cooking fires",
          "strength": "guideline",
          "supports": "hazard",
          "note": "Backs the HAZARD only. We cannot see whether the stove is lit, which is why the message describes the absence of a person, not the state of the stove."
