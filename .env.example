# ─── Environment variables — Elderly Assistant System ─────────────────────────
# Copy to .env (gitignored) or export in your shell. None are required for
# the smoke build; missing optional keys cause a graceful skip, not a crash.
#
# IMPORTANT — nothing in this repo auto-loads .env. There is no python-dotenv
# dependency; the scripts read os.environ directly. Writing a key into .env
# alone therefore does NOT make it visible to a stage, which surfaces as a
# confusing "graceful skip" rather than an error. Load it into the shell
# first:
#
#   bash/git-bash:  set -a && . ./.env && set +a
#   PowerShell:     Get-Content .env | ForEach-Object {
#                     if ($_ -match '^\s*([^#=]+)=(.*)$') {
#                       [Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim())
#                     } }
#
# Then run the stage in that same shell.

# Roboflow Universe API key (free: https://roboflow.com → settings → API).
# Required only when sources.roboflow.datasets in configs/dataset_sources.yaml
# is non-empty; without it the roboflow download stage skips with a warning
# and its classes (medicine_bottle, charger, wire, gas_cylinder) stay empty.
ROBOFLOW_API_KEY=

# DVC remote credentials (S3 / S3-compatible; see .dvc/config).
# Standard AWS resolution applies — an ~/.aws profile works instead.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
